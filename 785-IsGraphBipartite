3    bool check(int start, vector<vector<int>>& graph, vector<int>& color) {
4        
5        queue<int> q;
6        q.push(start);
7        color[start] = 0;
8        
9        while (!q.empty()) {
10            
11            int node = q.front();
12            q.pop();
13            
14            for (auto it : graph[node]) {
15                
16                if (color[it] == -1) {
17                    
18                    color[it] = !color[node];
19                    q.push(it);
20                }
21                
22                else if (color[it] == color[node]) {
23                    return false;
24                }
25            }
26        }
27        
28        return true;
29    }
